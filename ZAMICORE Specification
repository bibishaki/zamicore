## 11. Операционные интерлоки и композитные конвейеры НАДО

Каждая операция модификации памяти, изменения регистров оборудования или отправки моторных импульсов оформляется в виде неразрывной линейной цепочки проверочных шлюзов («НАДО»). Конвейер строится по принципу контракта (Design by Contract) с мгновенным сбросом при первом несоответствии (Fail-Fast).

```c
#ifndef ZAMI_PIPELINE_NODE_H
#define ZAMI_PIPELINE_NODE_H

#include "zami_frame_buffer.h"
#include <stdbool.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

#define ZAMI_MAX_CHAIN_NODES 32U

typedef struct zami_gate_result {
    bool     passed;
    uint32_t gate_id;
    uint32_t error_code;
    float    measured_metric;
} zami_gate_result_t;

typedef zami_gate_result_t (*zami_gate_predicate_t)(const zami_frame_t *frame,
                                                    const void *aux_context);

typedef struct zami_chain_node {
    uint32_t              gate_id;
    const char           *gate_name;
    zami_gate_predicate_t predicate_fn;
    uint32_t              flags;
} zami_chain_node_t;

typedef struct zami_interlock_chain {
    uint32_t          total_nodes;
    zami_chain_node_t nodes[ZAMI_MAX_CHAIN_NODES];
} zami_interlock_chain_t;

static inline bool zamicore_run_pipeline_chain(const zami_interlock_chain_t *chain,
                                               const zami_frame_t *frame,
                                               const void *aux_context,
                                               zami_gate_result_t *out_failure) {
    if (!chain || !frame) return false;
    for (uint32_t i = 0; i < chain->total_nodes; ++i) {
        zami_gate_result_t res = chain->nodes[i].predicate_fn(frame, aux_context);
        if (!res.passed) {
            if (out_failure) *out_failure = res;
            return false;
        }
    }
    return true;
}

#ifdef __cplusplus
}
#endif

#endif /* ZAMI_PIPELINE_NODE_H */

```

### 11.1. Базовый пятиступенчатый конвейер фиксации страта

1. **`MUST_BECOME_ISOLATED`:** Аллокация блока в Back Buffer DRAM с выравниванием по границе 4096 байт.
2. **`MUST_RECALCULATE`:** AVX2-пересчет векторных невязок $\vec{r}$ и скалярных проекций.
3. **`MUST_MEASURE_TENSION`:** Замер устойчивости волновода ($\Delta E < \tau_{\text{tension}}$).
4. **`MUST_VERIFY_HOMEOSTASIS`:** Контроль угла с вектором гомеостаза $\vec{\mathcal{H}}$ ($\cos \ge \tau_{\text{survival}}$).
5. **`MUST_SEAL_INTEGRITY`:** Аппаратный расчет CRC32C заголовка через SSE4.2.

