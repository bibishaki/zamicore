#ifndef ZAMI_LATCH_H
#define ZAMI_LATCH_H

#include <stdint.h>
#include <stdbool.h>
#include <stdatomic.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef struct zami_ready_latch {
    atomic_uint expected_mask;
    atomic_uint arrived_mask;
    uint64_t    cycle_timeout_ns;
    uint32_t    status_flags;
} zami_ready_latch_t;

static inline void zamicore_latch_signal_ready(zami_ready_latch_t *latch, uint32_t channel_id) {
    atomic_fetch_or_explicit(&latch->arrived_mask, (1U << channel_id), memory_order_release);
}

static inline bool zamicore_latch_is_open(const zami_ready_latch_t *latch) {
    uint32_t exp = atomic_load_explicit(&latch->expected_mask, memory_order_acquire);
    uint32_t arr = atomic_load_explicit(&latch->arrived_mask, memory_order_acquire);
    return (exp != 0) && (exp == arr);
}

#ifdef __cplusplus
}
#endif

#endif /* ZAMI_LATCH_H */

```

### 13.1. Разделение обязанностей Оркестратора и Синхронизатора

* **Оркестратор:** Коммутационная матрица. Формирует суб-кадры, настраивает инжекторы и распределяет потоки данных по моделям согласно маске аффинности задачи.
* **Синхронизатор:** Тактовый генератор фазовой когерентности. Исключает состояние гонки (Race Condition). Если быстрый канал закончил расчет за 2 мс, Синхронизатор удерживает его до завершения расчетов тяжелыми аналитическими каналами (15 мс), предотвращая принятие решений на неполных данных.

