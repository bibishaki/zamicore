    uint64_t parent_premises[32];                   /* 256 байт: посылки */
    uint64_t child_consequences[32];                /* 256 байт: следствия */
    int16_t  argument_weights[64];                  /* 128 байт: веса ребер */
    char     assertion_statement[512];              /* Текстовая формулировка утверждения */
