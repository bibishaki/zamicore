extern "C" {
#endif

#pragma pack(push, 1)

typedef struct zami_gestalt_node {
    float    bounding_centroid[ZAMI_QWEN_DIM]; /* 3584 байта: центр тяжести объема */
    float    bounding_radius;                  /* Радиус гипер-сферы охвата */
    
    uint64_t gestalt_id;                       /* Уникальный ID гештальта */
    uint64_t parent_gestalt_id;                /* Родительский супер-гештальт */
    uint64_t child_gestalts[16];               /* 128 байт: 16 дочерних узлов */
    uint64_t underlying_strata[32];            /* 256 байт: 32 страта Q1 */
    char     gestalt_tag[64];                  /* Символьный идентификатор */
    uint8_t  padding[44];                      /* Выравнивание до ровно 4096 байт */
} zami_gestalt_node_t;

#pragma pack(pop)

static_assert(sizeof(zami_gestalt_node_t) == 4096,
              "FATAL: zami_gestalt_node_t обязана занимать ровно 4096 байт");

