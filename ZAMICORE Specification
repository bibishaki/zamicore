## 5. Когнитивный Буфер Кадра (Cognitive Frame Buffer)

Тактовой единицей мышления ZAMICORE является **Когнитивный Кадр (Frame)**, оформленный структурой `zami_frame_t` фиксированного размера 4096 байт. Буфер кадра реализует двойную буферизацию (Double Buffering) в выделенной разделяемой памяти.

```c
#ifndef ZAMI_FRAME_BUFFER_H
#define ZAMI_FRAME_BUFFER_H

#include "zamicore_stratum.h"
#include <stdatomic.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

#pragma pack(push, 1)

typedef struct zami_frame {
    /* Геометрия волновода кадра (896 float x 4 байта = 3584 байта) */
    float    stimulus_raw[ZAMI_QWEN_DIM / 2];    /* 448 float = 1792B */
    float    target_injected[ZAMI_QWEN_DIM / 2]; /* 448 float = 1792B */

    /* Телеметрия кадра (64 байта) */
    float    manifold_tension;                   /* Зафиксированное напряжение Delta E */
    float    injection_temp;                     /* Рабочая температура T_inj */
    uint64_t frame_index;                        /* Порядковый номер такта мышления */
    uint64_t timestamp_ns;                       /* Системное время такта */
    uint32_t active_gestalt_id;                  /* ID активного гештальта */
    uint32_t flags;                              /* Состояние кадра: VALID, DIRTY, VETO */
    uint8_t  telemetry_pad[32];

    /* Навигационный контекст (384 байта) */
    uint64_t active_strata_refs[32];             /* 256 байт: привязанные страты Q1 */
    int16_t  strata_weights[32];                 /* 64 байта: веса релевантности */
    uint8_t  frame_reserved[64];                 /* Выравнивание до 4096 байт */
} zami_frame_t;

#pragma pack(pop)

static_assert(sizeof(zami_frame_t) == 4096,
              "FATAL: zami_frame_t обязана занимать ровно 4096 байт");

typedef struct zami_frame_pipeline {
    zami_frame_t  frames[2];
    atomic_uint   front_index;
} zami_frame_pipeline_t;

static inline zami_frame_t* zami_get_back_buffer(zami_frame_pipeline_t *pipe) {
    unsigned int front = atomic_load_explicit(&pipe->front_index, memory_order_relaxed);
    return &pipe->frames[1 - front];
}

static inline zami_frame_t* zami_get_front_buffer(zami_frame_pipeline_t *pipe) {
    unsigned int front = atomic_load_explicit(&pipe->front_index, memory_order_acquire);
    return &pipe->frames[front];
}

static inline void zami_frame_flip(zami_frame_pipeline_t *pipe) {
    unsigned int front = atomic_load_explicit(&pipe->front_index, memory_order_relaxed);
    atomic_store_explicit(&pipe->front_index, 1 - front, memory_order_release);
}

#ifdef __cplusplus
}
#endif

#endif /* ZAMI_FRAME_BUFFER_H */

```

### 5.1. Эпистемический V-Sync

Кадр формируется, векторизуется и верифицируется исключительно в теневом буфере (Back Buffer). Атомарный переброс (`zami_frame_flip`) на активный Front Buffer для выдачи наружу или исполнения разрешен только при условии, что измеренное фазовое напряжение $\Delta E$ не превышает порога $\tau_{\text{tension}}$. При обнаружении диссонанса кадр сбрасывается без побочных эффектов.

