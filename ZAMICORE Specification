## 7. Причинно-следственный граф действий (Causal Action DAG)

Для исполнения процедурных сценариев («Как сделать X») используется граф действий, в котором каждый узел упакован в страт с флагом `ZAMI_FLAG_ACTION_NODE`. Узел кодирует детерминированную триаду причинно-следственного перехода:

$$\vec{B}_{\text{pre}} \xrightarrow{\quad \text{Оператор ядра } \Delta\vec{h} \quad} \vec{B}_{\text{post}}$$

```c
#ifndef ZAMI_ACTION_DAG_H
#define ZAMI_ACTION_DAG_H

#include "zamicore_stratum.h"

#ifdef __cplusplus
extern "C" {
#endif

#pragma pack(push, 1)

typedef struct zami_action_payload {
    int8_t   precondition_barycenter[ZAMI_QWEN_DIM];  /* 896 байт: вектор требуемого состояния */
    int8_t   postcondition_barycenter[ZAMI_QWEN_DIM]; /* 896 байт: вектор ожидаемого результата */
    int8_t   operator_delta[ZAMI_QWEN_DIM];           /* 896 байт: вектор фазового сдвига */

    uint16_t action_opcode;                           /* Системный опкод операции */
    uint16_t timeout_ms;                              /* Таймаут исполнения */
    uint32_t flags;                                   /* Флаги: IDEMPOTENT, CRITICAL */
    char     command_template[504];                   /* Шаблон команды / системного вызова */

    uint64_t next_actions[64];                        /* 512 байт: ребра успехов и откатов */
    int16_t  transition_weights[64];                  /* 128 байт: вероятности переходов */
    uint8_t  action_reserved[192];                    /* Выравнивание до 4032 байт */
} zami_action_payload_t;

#pragma pack(pop)

static_assert(sizeof(zami_action_payload_t) == 4032,
              "FATAL: zami_action_payload_t обязана занимать ровно 4032 байта");

#ifdef __cplusplus
}
#endif

