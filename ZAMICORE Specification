    ZAMI_PROOF_EXPLORING   = 0x01, /* В процессе накопления свидетельств */
    ZAMI_PROOF_PROVEN      = 0x02, /* Доказано: кристаллизуется в аксиомы Q1 */
    ZAMI_PROOF_REFUTED     = 0x03, /* Опровергнуто: фиксируется как запретный тупик */
    ZAMI_PROOF_PARADOX     = 0x04  /* Неразрешимое противоречие */
} zami_proof_status_t;

#pragma pack(push, 1)

typedef struct zami_analytic_payload {
    int8_t   hypothesis_barycenter[ZAMI_QWEN_DIM]; /* 896 байт: центроид формулировки */
    
    uint32_t prior_probability;                     /* Априорная вероятность P(H) (Fixed Q16.16) */
    uint32_t posterior_probability;                 /* Апостериорная P(H|E) (Fixed Q16.16) */
