### 3. Бинарный контракт структур ядра (`zami_drift_engine.h`)

Интерфейс объединяет 4-килобайтный страт OpenZFS, V-буфер кадра (23 488 байт) и параметры детектора дрейфа:

```c
#ifndef ZAMI_DRIFT_ENGINE_H
#define ZAMI_DRIFT_ENGINE_H

#include <stdint.h>
#include <stdbool.h>
#include <stdalign.h>

#define ZAMI_DIM 896U
#define ZAMI_ALIGN_SIMD 32U

/* Классификация фазовой зоны дрейфа */
typedef enum {
    ZAMI_ZONE_LAMINAR_BOTTOM = 0x00, /* Зона 0: d_perp <= R_flat, U = 0 */
    ZAMI_ZONE_DRIFT_RESTORE  = 0x01, /* Зона 1: R_flat < d_perp <= R_wall (Латеральный возврат) */
    ZAMI_ZONE_DRIFT_SADDLE   = 0x02, /* Зона 1: Обнаружена седловина, запуск GAD */
    ZAMI_ZONE_WALL_BOUNCE    = 0x03, /* Зона 2: R_wall < d_perp <= R_limit (Упругий отскок) */
    ZAMI_ZONE_CIRCUIT_FAULT  = 0x04  /* Зона 3: d_perp > R_limit (Срыв потока, V-Buffer FAULT) */
} zami_drift_zone_t;

#pragma pack(push, 1)

/* Параметры геометрии и порогов детектора */
typedef struct alignas(64) zami_drift_params {
    float r_zero;               /* Входной радиус R_0 (0.85f) */
    float r_min;                /* Горловина R_min (0.35f) */
    float cone_alpha;           /* Экспонента сжатия alpha (1.50f) */
    float flat_gamma;           /* Резкость дна gamma (2.00f) */
    float delta_drift;          /* Полуширина зоны дрейфа (0.30f) */
    float delta_fault;          /* Предел срыва стенки (0.50f) */
    float k_drift_base;         /* Базовая жесткость k_0 (12.0f) */
    float eps_coplanar;         /* Порог сингулярности det(G) (1e-4f) */
    float tau_conflict;         /* Порог невязки предикатов ||delta_p|| (0.45f) */
    uint16_t layer_equator;     /* l_eq (12 для 24-слойной модели) */
    uint16_t layer_plastic;     /* l* (рубеж пластичности, срез 16) */
    uint8_t  pad[16];
} zami_drift_params_t;

/* Векторный дескриптор состояния дрейфа (128 байт) */
typedef struct alignas(64) zami_drift_telemetry {
    float    d_perp;            /* Радиальное отклонение ||h_perp|| */
    float    det_gram;          /* Определитель матрицы Грама det(G) */
    float    predicate_norm;    /* Норма невязки предикатов ||delta_p|| */
    uint8_t  current_zone;      /* Элемент zami_drift_zone_t */
    uint8_t  is_saddle_point;   /* Флаг локализации седловины GAD */
    uint16_t active_layer;      /* Текущий слой волновода */
    float    restoring_force_mag;/* Абсолютная величина силы ||F_restore|| */
    uint8_t  reserved[104];
} zami_drift_telemetry_t;

#pragma pack(pop)

#endif /* ZAMI_DRIFT_ENGINE_H */

```

