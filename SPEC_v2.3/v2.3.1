### 4. C11 / AVX2 Реализация ядра детектора и GAD (`zami_drift_engine.c`)

Код не производит динамических аллокаций памяти (`malloc` = 0), развернут на 256-битные векторные конвейеры AVX2/FMA3 и компилируется под FreeBSD 14+ Clang со строгим флагом `-fno-fast-math`:

```c
#include "zami_drift_engine.h"
#include <immintrin.h>
#include <math.h>

/* Детерминированная редукция регистра YMM по бинарному дереву */
static inline float hsum256_ps(__m256 v) {
    __m128 lo = _mm256_castps256_ps128(v);
    __m128 hi = _mm256_extractf128_ps(v, 1);
    __m128 sum = _mm_add_ps(lo, hi);
    sum = _mm_add_ps(sum, _mm_movehl_ps(sum, sum));
    sum = _mm_add_ss(sum, _mm_shuffle_ps(sum, sum, 1));
    return _mm_cvtss_f32(sum);
}

/* Вычисление скалярного произведения векторов R^896 на AVX2 (112 итераций) */
static inline float dot_product_896(const float *a, const float *b) {
    __m256 acc0 = _mm256_setzero_ps();
    __m256 acc1 = _mm256_setzero_ps();
    for (size_t i = 0; i < ZAMI_DIM; i += 16) {
        acc0 = _mm256_fmadd_ps(_mm256_load_ps(a + i), _mm256_load_ps(b + i), acc0);
        acc1 = _mm256_fmadd_ps(_mm256_load_ps(a + i + 8), _mm256_load_ps(b + i + 8), acc1);
    }
    return hsum256_ps(_mm256_add_ps(acc0, acc1));
}

/* Вычисление детерминанта 3x3 матрицы Грама G(q, a, u) */
static inline float compute_gram_det(float g00, float g01, float g02,
                                     float g10, float g11, float g12,
                                     float g20, float g21, float g22) {
    return g00 * (g11 * g22 - g12 * g21) -
           g01 * (g10 * g22 - g12 * g20) +
           g02 * (g10 * g21 - g11 * g20);
}

/*
 * Анализ фазового тензора дрейфа и синтез восстанавливающего воздействия.
 * Все векторные указатели кратны 32 байтам.
 */
zami_drift_zone_t zami_drift_evaluate_layer(const float *h_current,
                                            const float *c_canon,
                                            const float *q_prev,
                                            const float *a_prev,
                                            uint16_t layer_idx,
                                            const zami_drift_params_t *params,
                                            zami_drift_telemetry_t *telem,
                                            float *f_restore_out) {
    /* 1. Вычисление детерминанта Грама симплекса G(q_{k-1}, a_{k-1}, h) */
    float g00 = dot_product_896(q_prev, q_prev);
    float g01 = dot_product_896(q_prev, a_prev);
    float g02 = dot_product_896(q_prev, h_current);
    float g11 = dot_product_896(a_prev, a_prev);
    float g12 = dot_product_896(a_prev, h_current);
    float g22 = dot_product_896(h_current, h_current);

    float det_g = fabsf(compute_gram_det(g00, g01, g02, g01, g11, g12, g02, g12, g22));
    telem->det_gram = det_g;

    /* 2. Ортогонализация h относительно C_canon: h_perp = h - <h, C>C */
    float h_parallel = dot_product_896(h_current, c_canon);
    __m256 v_h_par = _mm256_set1_ps(h_parallel);
    __m256 norm_acc = _mm256_setzero_ps();

    for (size_t i = 0; i < ZAMI_DIM; i += 8) {
        __m256 v_h = _mm256_load_ps(h_current + i);
        __m256 v_c = _mm256_load_ps(c_canon + i);
        __m256 v_perp = _mm256_fnmadd_ps(v_h_par, v_c, v_h);
        _mm256_store_ps(f_restore_out + i, v_perp); /* Буферное хранение h_perp */
        norm_acc = _mm256_fmadd_ps(v_perp, v_perp, norm_acc);
    }
    float d_perp = sqrtf(hsum256_ps(norm_acc));
    telem->d_perp = d_perp;
    telem->active_layer = layer_idx;

    /* 3. Расчет послойных границ конфузора */
    float xi = powf((float)(params->layer_plastic - layer_idx) / 
                    (float)(params->layer_plastic - params->layer_equator), params->cone_alpha);
    float r_flat = params->r_min + (params->r_zero - params->r_min) * xi;
    float r_wall = r_flat * (1.0f + params->delta_drift);
    float r_limit = r_wall * (1.0f + params->delta_fault);

    /* ЗОНА 0: Ламинарное дно (U = 0) */
    if (d_perp <= r_flat) {
        for (size_t i = 0; i < ZAMI_DIM; i += 8) {
            _mm256_store_ps(f_restore_out + i, _mm256_setzero_ps());
        }
        telem->restoring_force_mag = 0.0f;
        telem->current_zone = ZAMI_ZONE_LAMINAR_BOTTOM;
        return ZAMI_ZONE_LAMINAR_BOTTOM;
    }

    /* ЗОНА 3: Срыв потока за предельный радиус (Circuit-Breaker) */
    if (d_perp > r_limit || det_g > (params->eps_coplanar * 100.0f)) {
        for (size_t i = 0; i < ZAMI_DIM; i += 8) {
            _mm256_store_ps(f_restore_out + i, _mm256_setzero_ps());
        }
        telem->restoring_force_mag = 0.0f;
        telem->current_zone = ZAMI_ZONE_CIRCUIT_FAULT;
        return ZAMI_ZONE_CIRCUIT_FAULT;
    }

    /* 4. Расчет амплитуды силы F(d_perp) */
    float k_l = params->k_drift_base * (1.0f + 0.5f * (float)(layer_idx - params->layer_equator) / 
                                        (float)(params->layer_plastic - params->layer_equator));
    float f_scalar = 0.0f;
    zami_drift_zone_t detected_zone;

    if (d_perp <= r_wall) {
        /* ЗОНА 1: Контролируемый дрейф */
        float delta = d_perp - r_flat;
        f_scalar = -k_l * powf(delta, params->flat_gamma) / (d_perp + 1e-7f);
        detected_zone = ZAMI_ZONE_DRIFT_RESTORE;
    } else {
        /* ЗОНА 2: Упругий отскок от стенки */
        float delta_drift_max = r_wall - r_flat;
        float f_drift_max = k_l * powf(delta_drift_max, params->flat_gamma);
        float k_wall = k_l * params->flat_gamma * delta_drift_max;
        float delta_wall = d_perp - r_wall;
        f_scalar = -(f_drift_max + k_wall * delta_wall) / (d_perp + 1e-7f);
        detected_zone = ZAMI_ZONE_WALL_BOUNCE;
    }

    /* 5. Векторизация F_restore = f_scalar * h_perp */
    __m256 v_f_scale = _mm256_set1_ps(f_scalar);
    for (size_t i = 0; i < ZAMI_DIM; i += 8) {
        __m256 v_perp = _mm256_load_ps(f_restore_out + i);
        _mm256_store_ps(f_restore_out + i, _mm256_mul_ps(v_perp, v_f_scale));
    }

    telem->restoring_force_mag = fabsf(f_scalar) * d_perp;
    telem->current_zone = detected_zone;
    return detected_zone;
}

/*
 * Шаг Gentlest Ascent Dynamics (GAD) на касательном пространстве гиперсферы.
 * Применяется при локализации седловых точек между аттракторами h_a и h_b.
 */
void zami_drift_gad_step(const float *h_current,
                         const float *grad_v,
                         const float *v_parallel,
                         float step_gamma,
                         float *h_next_out) {
    /* 1. Скалярное произведение <grad_V, v_parallel> */
    float g_dot_v = dot_product_896(grad_v, v_parallel);
    __m256 v_g_dot_v2 = _mm256_set1_ps(2.0f * g_dot_v);

    /* 2. Расчет F_gad = -(grad_V - 2 * (grad_V . v_par) * v_par) */
    for (size_t i = 0; i < ZAMI_DIM; i += 8) {
        __m256 v_gv = _mm256_load_ps(grad_v + i);
        __m256 v_vp = _mm256_load_ps(v_parallel + i);
        __m256 v_fgad = _mm256_sub_ps(_mm256_mul_ps(v_g_dot_v2, v_vp), v_gv);
        _mm256_store_ps(h_next_out + i, v_fgad); /* Временное сохранение F_gad */
    }

    /* 3. Проекция на касательное пространство: F_tangent = F_gad - <F_gad, h> * h */
    float fgad_dot_h = dot_product_896(h_next_out, h_current);
    __m256 v_fgad_dot_h = _mm256_set1_ps(fgad_dot_h);
    __m256 v_step = _mm256_set1_ps(step_gamma);
    __m256 norm_acc = _mm256_setzero_ps();

    for (size_t i = 0; i < ZAMI_DIM; i += 8) {
        __m256 v_fgad = _mm256_load_ps(h_next_out + i);
        __m256 v_hc = _mm256_load_ps(h_current + i);
        __m256 v_ftan = _mm256_fnmadd_ps(v_fgad_dot_h, v_hc, v_fgad);
        __m256 v_h_unnorm = _mm256_fmadd_ps(v_step, v_ftan, v_hc);
        _mm256_store_ps(h_next_out + i, v_h_unnorm);
        norm_acc = _mm256_fmadd_ps(v_h_unnorm, v_h_unnorm, norm_acc);
    }

    /* 4. Нормализация вектора h^{t+1} к единичной гиперсфере S^{d-1} */
    float inv_norm = 1.0f / sqrtf(hsum256_ps(norm_acc));
    __m256 v_inv_norm = _mm256_set1_ps(inv_norm);
    for (size_t i = 0; i < ZAMI_DIM; i += 8) {
        __m256 v_unnorm = _mm256_load_ps(h_next_out + i);
        _mm256_store_ps(h_next_out + i, _mm256_mul_ps(v_unnorm, v_inv_norm));
    }
}

```

